#--------------------------------------------------------------------
#  PRIMO Macro v1.0
#
#  Macro: PRIMOMacro_Verify_Dynalogs_PLAN
#  Purpose: To verify a treatment by reconstructing 
#               from dynalog files and performing the comparison
#               with the dose distribution calculated by PRMO for
#               the plan.
#  Requirements:
#    - An existing project with a linac set in an operational mode
#    - A source PSF
#    - A full set of DICOM files  (CT, Structures and Dynalog files)
#      in a DICOM repository
#  Adjust to your requirements:
#   - path of the DICOM and PRIMO repositories
#   - path and name of the source phase space file
#   - simulation parameters 
#
#  last update: March, 2018
#-------------------------------------------------------------------

# 1 - Link the psf:  modify the path to your own psf
link.psf \path=c:\primo\projects\psfs\cl21-6s1\cl21-6s1.iaeaheader

# 2- Set path to DICOM and PRIMO repositories:
set.primo.repository \path=c:\primo\projects\PRIMO\repository\pat01
set.dicom.repository \path=c:\primo\projects\DICOM\repository\pat01

# 3 - Import the CT scan 
import.ct \reduce

# 4 - Import the structures (not mandatory)
#      if the CT is a phantom made from structures use \fillbody 
import.structures \airoutbody \segment

# 5 - Reconstruct the plan from dynalogs. First import the plan
#      with the MLC=300
import.plan \mlc=300

# reconstruct from dynalogs with tolerance = 0.2 mm
import.dynalogs \timeres=50 \tolerance=0.2

# 6 - Config the simulation parameters for segments s2 and s3
config.simu  \seg=s2s3 \engine=dpm \coarse \seeds 

# 7 - Config variance reduction to splitting = 300 in the patient
config.vr \split=300

# 8 - Do simulate with DPM
simulate

# 10 - Gamma analysis inside body, default criteria, smoothing 
#        both dose distributions
gamma \primo \region=body \smooth=both \extended \report

# end-of-macro -----------------------------------------------------


